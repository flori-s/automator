<h1>Jobs</h1>

<%= form_with url: jobs_path, method: :get, local: true, class: "actions" do %>
  <select name="status">
    <option value="">All statuses</option>
    <% Automator::Job::STATUSES.each do |status| %>
      <option value="<%= status %>" <%= "selected" if params[:status] == status %>><%= status %></option>
    <% end %>
  </select>
  <select name="flow_id">
    <option value="">All flows</option>
    <% @flows.each do |flow| %>
      <option value="<%= flow.id %>" <%= "selected" if params[:flow_id].to_s == flow.id.to_s %>><%= flow.name %></option>
    <% end %>
  </select>
  <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search">
  <input type="submit" value="Filter">
<% end %>

<table>
  <thead>
    <tr><th>ID</th><th>Flow</th><th>Status</th><th>Run at</th><th>Attempts</th><th></th></tr>
  </thead>
  <tbody>
    <% @jobs.each do |job| %>
      <tr>
        <td><%= job.id %></td>
        <td><%= job.flow&.name %></td>
        <td><%= automator_status_badge(job.status) %></td>
        <td><%= job.run_at %></td>
        <td><%= job.attempts %></td>
        <td><%= link_to "View", job_path(job) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
